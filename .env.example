# Private
SECRET_MONGO_URI=
# Comma-separated CORS allowlist for the /api routes (e.g. the Vercel frontend
# origin). Empty reflects any Origin — fine since the API is public or
# signature-authenticated, never cookie-trusted. Only relevant on the backend.
CORS_ORIGINS=

# Public
PUBLIC_PGP_PASSPHRASE=
# Backend base URL for API + WebSocket. Empty = same-origin (the box and local
# dev). Set to https://s.sma.et on the Vercel frontend so it hits the box.
PUBLIC_API_BASE=
